{
  "name": "@hs1n/pi-statusline",
  "version": "1.0.0",
  "description": "A lightweight Pi Coding‑Agent status‑line extension.",
  "author": "Chase L.",
  "license": "MIT",
  "type": "module",

  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",

  "files": [
    "dist/**",
    "extensions/**",
    "README.md",
    "LICENSE"
  ],

  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },

  "devDependencies": {
    "typescript": "^5.3.3"
  },

  "keywords": [
    "pi",
    "statusline",
    "extension"
  ],

  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "pi": {
    "extensions": [
      "extensions/statusline.ts"
    ]
  }
}
